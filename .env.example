PRISM_DATA_DIR=./var
PRISM_HOST=127.0.0.1
PRISM_PORT=8765
PRISM_LOG_LEVEL=INFO
# Public HTTPS origin of this host (the tunnel URL); default is loopback
# PRISM_PUBLIC_URL=https://example.ngrok-free.app
# Name shown to recipients as the sharer
# PRISM_OWNER_LABEL=Your Name
# Set to true behind a trusted tunnel so rate limits key on the client address
# PRISM_TRUST_FORWARDED_FOR=false
